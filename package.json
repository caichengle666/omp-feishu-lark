{
  "name": "@caichengle/omp-feishu-lark",
  "version": "0.4.25",
  "description": "Feishu/Lark bridge for OMP coding agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caichengle666/omp-feishu-lark.git"
  },
  "homepage": "https://github.com/caichengle666/omp-feishu-lark#readme",
  "bugs": {
    "url": "https://github.com/caichengle666/omp-feishu-lark/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "feishu",
    "lark",
    "extension"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "omp-feishu": "bin/omp-feishu.cjs"
  },
  "omp": {
    "extensions": [
      "extension/index.ts"
    ]
  },
  "files": [
    "bin/**/*.cjs",
    "src/**/*.ts",
    "extension/**/*.ts",
    "tests/**/*.mjs",
    "support/feishu-supervisor.mjs",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "^17.2.12",
    "typebox": "^1.3.12"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test --timeout=30000 tests",
    "prepublishOnly": "bun run check && bun test --timeout=30000 tests"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^17.2.12",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typebox": "^1.3.12",
    "typescript": "5.9.2"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
